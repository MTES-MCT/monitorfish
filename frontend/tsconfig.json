{
  "extends": "@tsconfig/vite-react",
  "compilerOptions": {
    "allowJs": true,
    "erasableSyntaxOnly": false,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "alwaysStrict": true,
    "checkJs": false,
    // Override inherited value for CommonJS > ESM compatibility purpose
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "incremental": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    // https://github.com/cypress-io/cypress/issues/26308#issuecomment-1666236726
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@api/*": ["./src/api/*"],
      "@components/*": ["./src/components/*"],
      "@constants/*": ["./src/constants/*"],
      "@features/*": ["./src/features/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@libs/*": ["./src/libs/*"],
      "@pages/*": ["./src/pages/*"],
      "@store": ["./src/store/index.ts"],
      "@store/*": ["./src/store/*"],
      "@utils/*": ["./src/utils/*"],
      // Bare specifiers resolved from `src` (e.g. `domain/...`)
      "*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "target": "ES2022",
    "types": ["vite/client", "vite-plugin-svgr/client", "jest"],
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "**/*.cjs",
    "**/*.cts",
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "src/vite-env-override.d.ts",
    "src/ui/styled.d.ts",
    "src/matomo.d.ts"
  ],
  "exclude": ["node_modules/*", "scripts/matomo", "vite.config.ts"],
  "ts-node": {
    "esm": true,
    "swc": true,
    "transpileOnly": true
  }
}
