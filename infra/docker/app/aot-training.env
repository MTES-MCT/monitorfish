# Dummy values to start the backend at image build time (AOT cache training and check).
# The cache only holds classes: none of these values is used at runtime.
MONITORFISH_SERVER_PORT=8880
MONITORFISH_AJP_PORT=8000
HOST_IP=127.0.0.1
ENV_DB_URL=jdbc:postgresql://localhost:5432/aot
ENV_DB_DRIVER_CLASS_NAME=org.postgresql.Driver
MONITORFISH_MIGRATION_PATH=classpath:/db/migration
MONITORFISH_DATABASE_QUERY_TIMEOUT=10000
MONITORFISH_DATABASE_MISSIONS_ACTIONS_CHUNK_SIZE=100
MONITORFISH_API_PROTECTED_API_KEY=aot
MONITORFISH_API_PROTECTED_PATHS=/aot
MONITORFISH_API_PROTECTED_SUPER_USER_PATHS=/aot
MONITORFISH_API_PROTECTED_PUBLIC_PATHS=/aot
MONITORFISH_OIDC_ENABLED=true
MONITORFISH_OIDC_CLIENT_ID=aot
MONITORFISH_OIDC_CLIENT_SECRET=aot
MONITORFISH_OIDC_LOGIN_URL=http://aot
MONITORFISH_OIDC_SUCCESS_URL=http://aot
MONITORFISH_OIDC_ERROR_URL=http://aot
MONITORFISH_OIDC_REDIRECT_URI=http://aot
MONITORFISH_OIDC_ISSUER_URI=http://aot
MONITORFISH_OIDC_ISSUER_URI_EXTERNAL=http://aot
MONITORFISH_OIDC_AUTHORIZATION_URI=http://aot
MONITORFISH_OIDC_TOKEN_URI=http://aot
MONITORFISH_OIDC_USER_INFO_URI=http://aot
MONITORFISH_OIDC_JWK_SET_URI=http://aot
MONITORFISH_KAFKA_AIS_ENABLED=true
MONITORFISH_KAFKA_AIS_SERVERS=localhost:9092
MONITORFISH_SCHEDULING_ENABLED=false
MONITORFISH_SENTRY_ENABLED=false
SENTRY_DSN=
MONITORENV_URL=http://aot
