msgstr ""

#: ../source/flows/update-beacon-malfunctions.rst:5
#: e9888474ff944ce2a2c93b9c10322323
msgid "The ``Update beacon malfunctions`` flow identifies vessels with an activated beacon (supposed to emit) which have not been emitting for several hours. A beacon malfunction is generated and loaded to the ``beacon_malfunctions`` table for every occurrence of a beacon not emitting for a certain time. It also ends ongoing malfunctions when the beacon resumes emitting."
msgstr ""

#: ../source/flows/update-beacon-malfunctions.rst:9
#: e0851c11f3a74c68849519d2e56ceea3
msgid "Data from this table is used in the app by the :doc:`../vms-beacon-monitoring` module."
msgstr ""

#: ../source/flows/update-beacon-malfunctions.rst:11
#: 548743de199d4a328cb9e9391f606824
msgid "It is scheduled to run every 10 minutes."
msgstr ""
